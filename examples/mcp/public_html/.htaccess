# Generated by FastPlaz

RewriteEngine On

# MCP bearer token (config.json "mcp/token"): Apache does not pass the
# Authorization header to CGI programs. This rule passes it on
# (REDIRECT_HTTP_AUTHORIZATION); with "AllowOverride AuthConfig" the line
# "CGIPassAuth On" (Apache 2.4.13+) does the same.
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

AddHandler cgi-script .bin
AddHandler cgi-script .exe
Options +ExecCGI

DirectoryIndex mcp.bin index.html
ErrorDocument 500 '{"code": 500}'
ErrorDocument 404 '{"code": 404}'

RewriteCond %{REQUEST_FILENAME} -d [OR]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -l
RewriteRule ^(.*)$ - [NC,L]
RewriteRule ^(.*)$ mcp.bin/$1 [QSA,L]
