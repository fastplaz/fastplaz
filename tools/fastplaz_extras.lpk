      </SearchPaths>
      <Other>
        <Verbosity>
          <ShowWarn Value="False"/>
          <ShowHints Value="False"/>
        </Verbosity>
      </Other>
    </CompilerOptions>
    <Description Value="FastPlaz Extras Library"/>
    <Files Count="7">
      <Item1>
        <Filename Value="src\fastplaz_extras_register.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="fastplaz_extras_register"/>
      </Item1>
      <Item2>
        <Filename Value="..\FastPlaz\src\vendor\dcrypt\hash_tools.pas"/>
        <UnitName Value="hash_tools"/>
      </Item2>
      <Item3>
        <Filename Value="..\FastPlaz\src\vendor\dcrypt\dcpbase64.pas"/>
        <UnitName Value="DCPbase64"/>
      </Item3>
      <Item4>
        <Filename Value="..\FastPlaz\src\vendor\dcrypt\dcpconst.pas"/>
        <UnitName Value="DCPconst"/>
      </Item4>
      <Item5>
        <Filename Value="..\FastPlaz\src\vendor\dcrypt\dcpcrypt2.pas"/>
