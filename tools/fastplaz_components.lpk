<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="4">
    <Name Value="fastplaz_components"/>
    <Type Value="RunAndDesignTime"/>
    <Author Value="Luri Darmawan"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <OtherUnitFiles Value="../FastPlaz/src/components"/>
        <UnitOutputDirectory Value="lib/components/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="FastPlaz Components (TRemoteDataset)"/>
    <Version Major="1"/>
    <Files Count="1">
      <Item1>
        <Filename Value="../FastPlaz/src/components/remotedataset_component.pas"/>
        <HasRegisterProc Value="True"/>
        <UnitName Value="remotedataset_component"/>
      </Item1>
    </Files>
    <RequiredPkgs Count="2">
      <Item1>
        <PackageName Value="fastplaz_runtime"/>
      </Item1>
      <Item2>
        <PackageName Value="LCL"/>
      </Item2>
    </RequiredPkgs>
    <UsageOptions>
      <UnitPath Value="$(PkgOutDir)"/>
    </UsageOptions>
    <PublishOptions>
      <Version Value="2"/>
    </PublishOptions>
  </Package>
</CONFIG>
